# Copy to `.env` and fill in real values. See comments in `.env` for Dokploy.

# Avoid cross-platform .pyc issues when using Docker bind mount (macOS host + Linux container).
PYTHONDONTWRITEBYTECODE=1

DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string
DJANGO_DEBUG=false
DEBUG=false

# Leave empty to use SQLite (local). Set for PostgreSQL (Dokploy, etc.).
# Example: postgres://user:password@hostname:5432/dbname
DATABASE_URL=

DJANGO_ALLOWED_HOSTS=request.iraniu.uk,www.request.iraniu.uk,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://request.iraniu.uk,http://request.iraniu.uk
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000

ENVIRONMENT=PROD
TELEGRAM_MODE=polling
STATIC_VERSION=1
MEDIA_URL=/media/
# Public base for /media/ absolute URLs; Site Settings production_base_url (HTTPS) overrides when set.
INSTAGRAM_BASE_URL=https://request.iraniu.uk
INSTAGRAM_REDIRECT_URI=https://request.iraniu.uk/settings/hub/instagram/callback/
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=generate-a-random-secret-for-meta-webhook

# Optional: `python manage.py set_instagram_token` reads these once to seed DB
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# Optional: AI features (dashboard / moderation)
# OPENAI_API_KEY=

# Telegram bot tokens are stored encrypted in the database (Settings / Bots), not via env.
