# Copy to `.env` and fill in real values.
# DJANGO_ENV is the single switch: everything else follows.

# Avoid cross-platform .pyc issues when using Docker bind mount (macOS host + Linux container).
PYTHONDONTWRITEBYTECODE=1

# ─── Primary mode switch ───────────────────────────────────────────────
# development → DEBUG=True, ENVIRONMENT=DEV, SSL off, localhost CSRF/hosts, local Instagram URLs
# production  → DEBUG=False, ENVIRONMENT=PROD, SSL on, HSTS, production URLs
DJANGO_ENV=production

# Required in production (ignored when DJANGO_ENV=development with default secret)
DJANGO_SECRET_KEY=change-me-in-production-use-long-random-string

# Database: empty = SQLite (local). Set for PostgreSQL (server).
# Example: postgres://user:password@hostname:5432/dbname
DATABASE_URL=

# ─── Optional overrides (only needed if DJANGO_ENV defaults don't fit) ─
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# ENVIRONMENT=PROD

TELEGRAM_MODE=polling
STATIC_VERSION=1
MEDIA_URL=/media/

# Instagram: leave empty in development (defaults to http://127.0.0.1:8000).
# In production set your real domain.
INSTAGRAM_BASE_URL=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=generate-a-random-secret-for-meta-webhook

# Optional: `python manage.py set_instagram_token` reads these once to seed DB
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=

# Optional: AI features (dashboard / moderation)
# OPENAI_API_KEY=

# Telegram bot tokens are stored encrypted in the database (Settings / Bots), not via env.
